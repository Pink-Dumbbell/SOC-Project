alert http any any -> $HOME_NET any (msg:"SOC Scanner - Dirsearch"; http.user_agent; content:"dirsearch"; nocase; sid:1000012; rev:1;)
alert http any any -> $HOME_NET any (msg:"SOC Scanner - ffuf"; http.user_agent; content:"ffuf"; nocase; sid:1000013; rev:1;)
alert arp any any -> any any (msg:"SOC ARP Spoofing - Excessive ARP Replies"; threshold:type both, track by_src, count 20, seconds 5; sid:1000014; rev:1;)
